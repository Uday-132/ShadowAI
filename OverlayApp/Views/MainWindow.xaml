<Window x:Class="OverlayApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OverlayApp.Views"
        xmlns:models="clr-namespace:OverlayApp.Models"
        xmlns:helpers="clr-namespace:OverlayApp.Helpers"
        mc:Ignorable="d"
        Title="Shadow AI" 
        Icon="/shadow_ai.ico"
        Height="{Binding WindowHeight, Mode=TwoWay}" 
        Width="{Binding WindowWidth, Mode=TwoWay}"
        MinHeight="380"
        MinWidth="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ShowActivated="False"
        ResizeMode="CanResizeWithGrip"
        Cursor="Arrow">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Animates the border gradient angle continuously to create a premium rolling border glow -->
                    <DoubleAnimation Storyboard.TargetName="MainBorder"
                                     Storyboard.TargetProperty="BorderBrush.(Brush.RelativeTransform).(RotateTransform.Angle)"
                                     From="0" To="360" Duration="0:0:6" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <!-- Standard WPF Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisConverter"/>

        <!-- Sleek ScrollBar Template -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#40FFFFFF" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="2.5" Background="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Slider Template -->
        <Style x:Key="SleekSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="TrackBackground" Height="4" CornerRadius="2" Background="#25FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Height="4" VerticalAlignment="Center" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{Binding Tag, ElementName=MainBorder}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Height="4" VerticalAlignment="Center" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Focusable="False" Cursor="Arrow">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="6" Background="#FFFFFF" BorderBrush="{Binding Tag, ElementName=MainBorder}" BorderThickness="2.5" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Toggle Switch Template (representing CheckBox) -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent" Cursor="Arrow">
                            <BulletDecorator.Bullet>
                                <Grid VerticalAlignment="Center">
                                    <Border x:Name="Track" Width="32" Height="16" CornerRadius="8" Background="#33FFFFFF" BorderThickness="0" SnapsToDevicePixels="True"/>
                                    <Border x:Name="Thumb" Width="12" Height="12" CornerRadius="6" Background="#FFFFFF" HorizontalAlignment="Left" Margin="2" SnapsToDevicePixels="True">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{Binding Tag, ElementName=MainBorder}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                             To="16" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ProgressBar Template -->
        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border CornerRadius="3" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme definitions mapping to dynamic styling triggers -->
        <Style x:Key="MainBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F40A0E17"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform CenterX="0.5" CenterY="0.5" Angle="0"/>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#4000D2FF" Offset="0"/>
                        <GradientStop Color="#1500D2FF" Offset="0.5"/>
                        <GradientStop Color="#3000D2FF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Tag">
                <Setter.Value>
                    <SolidColorBrush Color="#FF00D2FF"/>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <SolidColorBrush x:Key="AccentBrush" Color="#FF00D2FF"/>
            </Style.Resources>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Theme}" Value="Neon">
                    <Setter Property="Background" Value="#F00D0A20"/>
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <LinearGradientBrush.RelativeTransform>
                                    <RotateTransform CenterX="0.5" CenterY="0.5" Angle="0"/>
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="#40FF00A0" Offset="0"/>
                                <GradientStop Color="#15FF00A0" Offset="0.5"/>
                                <GradientStop Color="#30FF00A0" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag">
                        <Setter.Value>
                            <SolidColorBrush Color="#FFFF00A0"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Theme}" Value="Emerald">
                    <Setter Property="Background" Value="#F0060F0C"/>
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <LinearGradientBrush.RelativeTransform>
                                    <RotateTransform CenterX="0.5" CenterY="0.5" Angle="0"/>
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="#4000FFCC" Offset="0"/>
                                <GradientStop Color="#1500FFCC" Offset="0.5"/>
                                <GradientStop Color="#3000FFCC" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag">
                        <Setter.Value>
                            <SolidColorBrush Color="#FF00FFCC"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Theme}" Value="Sunset">
                    <Setter Property="Background" Value="#F0120608"/>
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <LinearGradientBrush.RelativeTransform>
                                    <RotateTransform CenterX="0.5" CenterY="0.5" Angle="0"/>
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="#40FF7700" Offset="0"/>
                                <GradientStop Color="#15FF7700" Offset="0.5"/>
                                <GradientStop Color="#30FF7700" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag">
                        <Setter.Value>
                            <SolidColorBrush Color="#FFFF7700"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Navigation tab button style — pill-shaped active indicator -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Widgets"/>
            <Setter Property="Foreground" Value="#66FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Pill" CornerRadius="7" Background="Transparent" Padding="10,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FF000000"/>
                                <Setter TargetName="Pill" Property="Background" Value="{Binding Tag, ElementName=MainBorder}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#DDFFFFFF"/>
                                <Setter TargetName="Pill" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segment control radio button style — pill chips -->
        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="BgBorder" CornerRadius="6" Background="#10FFFFFF" BorderThickness="1" BorderBrush="#18FFFFFF" Padding="9,4" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="{Binding Tag, ElementName=MainBorder}"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="{Binding Tag, ElementName=MainBorder}"/>
                                <Setter Property="Foreground" Value="#FF000000"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#1EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border x:Name="MainBorder" Style="{StaticResource MainBorderStyle}" CornerRadius="14" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="310" Opacity="0.65" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Title bar / Header -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Nav Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Content Frame -->
                <RowDefinition Height="*"/>
                <!-- Row 3: Settings Drawer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar / Header -->
            <Grid Grid.Row="0" Panel.ZIndex="1000" Margin="10,7,10,5" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/shadow_ai.ico" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold">
                        <Run Text="SHADOW" Foreground="#66FFFFFF"/>
                        <Run Text="AI" Foreground="{Binding Tag, ElementName=MainBorder}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Session Pill (center) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10" Padding="10,3" Background="#16FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SessionTimerDisplay}" Foreground="{Binding Tag, ElementName=MainBorder}" FontSize="9.5" FontWeight="Bold"/>
                </Border>

                <!-- Actions (Pin, Settings, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pin -->
                    <Button x:Name="PinButton" Command="{Binding ToggleClickThroughCommand}" Background="Transparent" BorderThickness="0" Cursor="Arrow">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="5,4">
                                                <Path x:Name="Icon" Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z" 
                                                      Fill="#44FFFFFF" Width="11" Height="11" Stretch="Uniform"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Icon" Property="Fill" Value="#AAFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsClickThrough}" Value="True">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" Padding="5,4">
                                                        <Path Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z" 
                                                              Fill="{Binding Tag, ElementName=MainBorder}" Width="11" Height="11" Stretch="Uniform"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Settings -->
                    <Button Command="{Binding ToggleSettingsCommand}" Background="Transparent" BorderThickness="0" Cursor="Arrow">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="5,4">
                                    <Path x:Name="Icon" Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" 
                                          Fill="#44FFFFFF" Width="11" Height="11" Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Icon" Property="Fill" Value="#AAFFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Close -->
                    <Button Command="{Binding CloseAppCommand}" Background="Transparent" BorderThickness="0" Cursor="Arrow">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="5,4">
                                    <Path x:Name="Icon" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                          Fill="#44FFFFFF" Width="11" Height="11" Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Icon" Property="Fill" Value="#FFFF453A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Thin accent divider below header -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Margin="8,0" Background="#18FFFFFF"/>

            <!-- Navigation Tab Bar -->
            <Border Grid.Row="1" Margin="6,5,6,3" Background="#0AFFFFFF" CornerRadius="10" Padding="3,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <RadioButton Grid.Column="0" Content="NOTES" Style="{StaticResource TabButtonStyle}" 
                                 IsChecked="{Binding IsNotesActive, Mode=OneWay}"
                                 Command="{Binding SelectWidgetCommand}" CommandParameter="Notes"/>
                                 
                    <RadioButton Grid.Column="1" Content="TIMER" Style="{StaticResource TabButtonStyle}" 
                                 IsChecked="{Binding IsTimerActive, Mode=OneWay}"
                                 Command="{Binding SelectWidgetCommand}" CommandParameter="Timer"/>
                                 
                    <RadioButton Grid.Column="2" Style="{StaticResource TabButtonStyle}" 
                                  IsChecked="{Binding IsTxtScanActive, Mode=OneWay}"
                                  Command="{Binding SelectWidgetCommand}" CommandParameter="TxtScan">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SCAN" VerticalAlignment="Center"/>
                            <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" 
                                  Fill="#FFFF5555" Width="8" Height="8" Stretch="Uniform" Margin="3,0,0,0" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFeatureLocked}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Grid.Column="3" Style="{StaticResource TabButtonStyle}" 
                                  IsChecked="{Binding IsVoiceScanActive, Mode=OneWay}"
                                  Command="{Binding SelectWidgetCommand}" CommandParameter="VoiceScan">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VOICE" VerticalAlignment="Center"/>
                            <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" 
                                  Fill="#FFFF5555" Width="8" Height="8" Stretch="Uniform" Margin="3,0,0,0" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFeatureLocked}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Grid.Column="4" Content="PROFILE" Style="{StaticResource TabButtonStyle}" 
                                  IsChecked="{Binding IsProfileActive, Mode=OneWay}"
                                  Command="{Binding SelectWidgetCommand}" CommandParameter="Profile"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="2" Margin="6,2,6,8">
                
                <!-- NOTES WIDGET -->
                <Grid Visibility="{Binding IsNotesActive, Converter={StaticResource BoolToVis}}">
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="8">
                        <TextBox Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" BorderThickness="0" Foreground="#EFFFFFFF" 
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" FontSize="{Binding AppFontSize}"
                                 SelectionBrush="{Binding Tag, ElementName=MainBorder}" CaretBrush="#FFFFFF"/>
                    </Border>
                </Grid>


                <!-- PRESENTATION TIMER WIDGET -->
                <Grid Visibility="{Binding IsTimerActive, Converter={StaticResource BoolToVis}}">
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Timer Display -->
                            <TextBlock Text="{Binding TimerDisplay}" FontSize="36" FontFamily="Consolas" FontWeight="Light" 
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            
                            <!-- Timer Buttons -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,4">
                                <!-- Start/Pause Button -->
                                <Button Command="{Binding TimerStartPauseCommand}" Margin="0,0,12,0" Cursor="Arrow" Width="88" Height="32">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="8" Background="{Binding Tag, ElementName=MainBorder}" Padding="8,4">
                                                            <TextBlock x:Name="BtnText" Text="START" Foreground="#000000" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.95"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border CornerRadius="6" Background="#33FFFFFF" BorderBrush="{Binding Tag, ElementName=MainBorder}" BorderThickness="1" Padding="8,4">
                                                                    <TextBlock Text="PAUSE" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Reset Button -->
                                <Button Command="{Binding TimerResetCommand}" Cursor="Arrow" Width="88" Height="32">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Background="#18FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="8,4">
                                                <TextBlock Text="RESET" Foreground="#E0FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TXT SCAN WIDGET -->
                <Grid Visibility="{Binding IsTxtScanActive, Converter={StaticResource BoolToVis}}">
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Row 0: Option Toggles -->
                                <RowDefinition Height="Auto"/> <!-- Row 1: Scan Buttons -->
                                <RowDefinition Height="Auto"/> <!-- Row 2: Screenshot Batch Strip -->
                                <RowDefinition Height="*"/>    <!-- Row 3: Response Area -->
                                <RowDefinition Height="Auto"/> <!-- Row 4: Follow-up Chat Box -->
                                <RowDefinition Height="Auto"/> <!-- Row 5: Loader ProgressBar -->
                            </Grid.RowDefinitions>

                             <!-- Option Toggles (Scan Type & Language) -->
                             <Grid Grid.Row="0" Margin="0,0,0,8">
                                 <DockPanel LastChildFill="False">
                                     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                         <TextBlock Text="SCAN TYPE:" VerticalAlignment="Center" Foreground="#99FFFFFF" FontSize="9.5" FontWeight="Bold" Margin="0,0,6,0"/>
                                         <RadioButton Content="NORMAL SCAN" Style="{StaticResource SegmentButtonStyle}" GroupName="TxtScanMode" IsChecked="{Binding IsNormalScanMode, Mode=TwoWay}"/>
                                         <RadioButton Content="MCQ SCAN" Style="{StaticResource SegmentButtonStyle}" GroupName="TxtScanMode" IsChecked="{Binding IsMcqScanMode, Mode=TwoWay}"/>
                                         <RadioButton Content="CODING SCAN" Style="{StaticResource SegmentButtonStyle}" GroupName="TxtScanMode" IsChecked="{Binding IsCodingScanMode, Mode=TwoWay}"/>
                                     </StackPanel>

                                     <!-- Language Selector for Coding Scan -->
                                     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Visibility="{Binding IsCodingScanMode, Converter={StaticResource BoolToVis}}">
                                         <TextBlock Text="LANG:" VerticalAlignment="Center" Foreground="#88FFFFFF" FontSize="8.5" FontWeight="Bold" Margin="6,0,4,0"/>
                                         <RadioButton Content="Python" Style="{StaticResource SegmentButtonStyle}" GroupName="CodingLang" IsChecked="{Binding IsPythonSelected, Mode=TwoWay}"/>
                                         <RadioButton Content="JS" Style="{StaticResource SegmentButtonStyle}" GroupName="CodingLang" IsChecked="{Binding IsJsSelected, Mode=TwoWay}"/>
                                         <RadioButton Content="Java" Style="{StaticResource SegmentButtonStyle}" GroupName="CodingLang" IsChecked="{Binding IsJavaSelected, Mode=TwoWay}"/>
                                         <RadioButton Content="C++" Style="{StaticResource SegmentButtonStyle}" GroupName="CodingLang" IsChecked="{Binding IsCppSelected, Mode=TwoWay}"/>
                                         <RadioButton Content="HTML" Style="{StaticResource SegmentButtonStyle}" GroupName="CodingLang" IsChecked="{Binding IsHtmlSelected, Mode=TwoWay}"/>
                                         <RadioButton Content="CSS" Style="{StaticResource SegmentButtonStyle}" GroupName="CodingLang" IsChecked="{Binding IsCssSelected, Mode=TwoWay}"/>
                                     </StackPanel>
                                 </DockPanel>
                             </Grid>

                              <!-- Scan Controls Section -->
                              <StackPanel Grid.Row="1" Margin="0,0,0,6">
                                  
                                  <!-- Row 1: Primary Controls (+ CAPTURE, SEND, Copy, Refresh) -->
                                  <Grid Margin="0,0,0,4">
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="*"/>
                                          <ColumnDefinition Width="*"/>
                                          <ColumnDefinition Width="Auto"/>
                                          <ColumnDefinition Width="Auto"/>
                                      </Grid.ColumnDefinitions>

                                      <!-- + CAPTURE SCREENSHOT Button -->
                                      <Button Grid.Column="0" Command="{Binding StartScanCommand}" Cursor="Arrow" Height="32" Margin="0,0,4,0">
                                          <Button.Template>
                                              <ControlTemplate TargetType="Button">
                                                  <Border CornerRadius="7" Background="{Binding Tag, ElementName=MainBorder}" Padding="6,4">
                                                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                          <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" 
                                                                Fill="#000000" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                                          <TextBlock Text="+ CAPTURE" Foreground="#000000" FontSize="10" FontWeight="Bold"/>
                                                      </StackPanel>
                                                  </Border>
                                                  <ControlTemplate.Triggers>
                                                      <Trigger Property="IsMouseOver" Value="True">
                                                          <Setter Property="Opacity" Value="0.9"/>
                                                      </Trigger>
                                                  </ControlTemplate.Triggers>
                                              </ControlTemplate>
                                          </Button.Template>
                                      </Button>

                                      <!-- SEND BUTTON -->
                                      <Button Grid.Column="1" Command="{Binding SendScreenshotsCommand}" Cursor="Arrow" Height="32" Margin="0,0,4,0">
                                          <Button.Template>
                                              <ControlTemplate TargetType="Button">
                                                  <Border x:Name="SendBorder" CornerRadius="7" Background="#10B981" Padding="6,4">
                                                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                          <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" 
                                                                Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                                          <TextBlock Text="{Binding SendButtonText}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                                      </StackPanel>
                                                  </Border>
                                                  <ControlTemplate.Triggers>
                                                      <Trigger Property="IsMouseOver" Value="True">
                                                          <Setter TargetName="SendBorder" Property="Background" Value="#059669"/>
                                                      </Trigger>
                                                  </ControlTemplate.Triggers>
                                              </ControlTemplate>
                                          </Button.Template>
                                      </Button>

                                      <!-- Copy Button (Original Position Next to Send) -->
                                      <Button Grid.Column="2" Command="{Binding CopyTxtCommand}" Cursor="Arrow" Height="32" Width="32" Margin="0,0,4,0">
                                          <Button.Template>
                                              <ControlTemplate TargetType="Button">
                                                  <Border x:Name="CopyBorder" CornerRadius="4" Background="#18FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="4">
                                                      <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" 
                                                            Fill="#88FFFFFF" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                  </Border>
                                                  <ControlTemplate.Triggers>
                                                      <Trigger Property="IsMouseOver" Value="True">
                                                          <Setter TargetName="CopyBorder" Property="Background" Value="#28FFFFFF"/>
                                                      </Trigger>
                                                  </ControlTemplate.Triggers>
                                              </ControlTemplate>
                                          </Button.Template>
                                      </Button>

                                      <!-- Clear/Refresh Button (Original Position Next to Copy) -->
                                      <Button Grid.Column="3" Command="{Binding ClearTxtScanCommand}" Cursor="Arrow" Height="32" Width="32">
                                          <Button.Template>
                                              <ControlTemplate TargetType="Button">
                                                  <Border x:Name="ClearBorder" CornerRadius="4" Background="#18FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="4">
                                                      <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" 
                                                            Fill="#88FFFFFF" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                  </Border>
                                                  <ControlTemplate.Triggers>
                                                      <Trigger Property="IsMouseOver" Value="True">
                                                          <Setter TargetName="ClearBorder" Property="Background" Value="#28FFFFFF"/>
                                                      </Trigger>
                                                  </ControlTemplate.Triggers>
                                              </ControlTemplate>
                                          </Button.Template>
                                      </Button>
                                  </Grid>

                                  <!-- Sub-Row: Secondary Utility Controls (Under Capture and Send section) -->
                                  <DockPanel LastChildFill="False">
                                      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                          <!-- Font Size Decrement (A-) -->
                                          <Button Command="{Binding DecreaseFontSizeCommand}" Cursor="Arrow" Height="24" Padding="8,2" Margin="0,0,4,0">
                                              <Button.Template>
                                                  <ControlTemplate TargetType="Button">
                                                      <Border x:Name="BtnBorder" CornerRadius="4" Background="#14FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                          <TextBlock Text="A-" Foreground="#B0FFFFFF" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                      </Border>
                                                      <ControlTemplate.Triggers>
                                                          <Trigger Property="IsMouseOver" Value="True">
                                                              <Setter TargetName="BtnBorder" Property="Background" Value="#25FFFFFF"/>
                                                              <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                                                          </Trigger>
                                                      </ControlTemplate.Triggers>
                                                  </ControlTemplate>
                                              </Button.Template>
                                          </Button>

                                          <!-- Font Size Increment (A+) -->
                                          <Button Command="{Binding IncreaseFontSizeCommand}" Cursor="Arrow" Height="24" Padding="8,2" Margin="0,0,4,0">
                                              <Button.Template>
                                                  <ControlTemplate TargetType="Button">
                                                      <Border x:Name="BtnBorder" CornerRadius="4" Background="#14FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                          <TextBlock Text="A+" Foreground="#B0FFFFFF" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                      </Border>
                                                      <ControlTemplate.Triggers>
                                                          <Trigger Property="IsMouseOver" Value="True">
                                                              <Setter TargetName="BtnBorder" Property="Background" Value="#25FFFFFF"/>
                                                              <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                                                          </Trigger>
                                                      </ControlTemplate.Triggers>
                                                  </ControlTemplate>
                                              </Button.Template>
                                          </Button>

                                          <!-- Window Height Expansion Toggle Button -->
                                          <Button Command="{Binding ToggleExpandHeightCommand}" Cursor="Arrow" Height="24" Padding="8,2" Margin="0,0,4,0">
                                              <Button.Template>
                                                  <ControlTemplate TargetType="Button">
                                                      <Border x:Name="BtnBorder" CornerRadius="4" Background="#14FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                          <TextBlock Text="{Binding ExpandHeightButtonText}" Foreground="#B0FFFFFF" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                                      </Border>
                                                      <ControlTemplate.Triggers>
                                                          <Trigger Property="IsMouseOver" Value="True">
                                                              <Setter TargetName="BtnBorder" Property="Background" Value="#25FFFFFF"/>
                                                              <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                                                          </Trigger>
                                                      </ControlTemplate.Triggers>
                                                  </ControlTemplate>
                                              </Button.Template>
                                          </Button>

                                          <!-- Max Screenshots Limit Cycle Button -->
                                          <Button Command="{Binding CycleMaxScreenshotsLimitCommand}" Cursor="Arrow" Height="24" Padding="8,2" Margin="0,0,4,0">
                                              <Button.Template>
                                                  <ControlTemplate TargetType="Button">
                                                      <Border x:Name="BtnBorder" CornerRadius="4" Background="#14FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                          <TextBlock Text="{Binding MaxScreenshotsButtonText}" Foreground="#B0FFFFFF" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                                      </Border>
                                                      <ControlTemplate.Triggers>
                                                          <Trigger Property="IsMouseOver" Value="True">
                                                              <Setter TargetName="BtnBorder" Property="Background" Value="#25FFFFFF"/>
                                                              <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                                                          </Trigger>
                                                      </ControlTemplate.Triggers>
                                                  </ControlTemplate>
                                              </Button.Template>
                                          </Button>
                                      </StackPanel>

                                      <!-- MCQ Scan Notice (Shown under capture/send when in MCQ mode) -->
                                      <Border DockPanel.Dock="Right" Background="#25FF9900" BorderBrush="#55FF9900" BorderThickness="1" CornerRadius="4" Padding="8,2"
                                              Visibility="{Binding IsMcqScanMode, Converter={StaticResource BoolToVis}}">
                                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                              <TextBlock Text="⚠️ Note: Do not capture 2+ questions in one screenshot" Foreground="#FFD54F" FontSize="8.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                          </StackPanel>
                                      </Border>
                                  </DockPanel>

                              </StackPanel>

                             <!-- Screenshot Batch Status & Thumbnails Bar -->
                             <Grid Grid.Row="2" Margin="0,0,0,6">
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="Auto"/>
                                     <RowDefinition Height="Auto"/>
                                 </Grid.RowDefinitions>

                                 <!-- Badge / Header Text -->
                                 <Border Grid.Row="0" Background="#18FFFFFF" CornerRadius="5" Padding="8,3" Margin="0,0,0,4">
                                     <DockPanel>
                                         <TextBlock Text="{Binding ScreenshotsBadgeText}" Foreground="#E5E7EB" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                     </DockPanel>
                                 </Border>

                                 <!-- Thumbnails ScrollViewer -->
                                 <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding HasCapturedScreenshots, Converter={StaticResource BoolToVis}}">
                                     <ItemsControl ItemsSource="{Binding CapturedScreenshots}">
                                         <ItemsControl.ItemsPanel>
                                             <ItemsPanelTemplate>
                                                 <StackPanel Orientation="Horizontal"/>
                                             </ItemsPanelTemplate>
                                         </ItemsControl.ItemsPanel>
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                 <Border CornerRadius="5" BorderBrush="#35FFFFFF" BorderThickness="1" Background="#33000000" Margin="0,0,6,0" Width="66" Height="44" ClipToBounds="True">
                                                     <Grid>
                                                         <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/>
                                                         <!-- Label Badge -->
                                                         <Border Background="#E6000000" CornerRadius="3" VerticalAlignment="Bottom" HorizontalAlignment="Left" Padding="4,1" Margin="2">
                                                             <TextBlock Text="{Binding DisplayName}" Foreground="#FFFFFF" FontSize="8" FontWeight="Bold"/>
                                                         </Border>
                                                         <!-- Delete (x) Button -->
                                                         <Button Command="{Binding DataContext.RemoveScreenshotCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                 CommandParameter="{Binding}" 
                                                                 HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                                 Margin="2" Width="16" Height="16" Cursor="Arrow">
                                                             <Button.Template>
                                                                 <ControlTemplate TargetType="Button">
                                                                     <Border CornerRadius="8" Background="#E5EF4444">
                                                                         <TextBlock Text="✕" Foreground="#FFFFFF" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                                     </Border>
                                                                 </ControlTemplate>
                                                             </Button.Template>
                                                         </Button>
                                                     </Grid>
                                                 </Border>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </ScrollViewer>
                             </Grid>

                             <!-- Chat-Style Response Area -->
                             <Border Grid.Row="3" Background="#0AFFFFFF" CornerRadius="6" Padding="3">
                                 <ScrollViewer x:Name="TxtScanScrollViewer" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                                     <Grid>
                                         <!-- Fallback: plain ScanResponseText when no chat bubbles exist yet -->
                                         <TextBlock local:TextBlockHelper.FormattedText="{Binding ScanResponseText}" Foreground="#E0FFFFFF" FontSize="{Binding AppFontSize}" TextWrapping="Wrap" Background="Transparent" Padding="6">
                                             <TextBlock.Style>
                                                 <Style TargetType="TextBlock">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding ChatBubbles.Count}" Value="0">
                                                             <Setter Property="Visibility" Value="Visible"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </TextBlock.Style>
                                         </TextBlock>

                                         <!-- Chat Bubbles ItemsControl -->
                                         <ItemsControl ItemsSource="{Binding ChatBubbles}">
                                             <ItemsControl.Style>
                                                 <Style TargetType="ItemsControl">
                                                     <Setter Property="Visibility" Value="Visible"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding ChatBubbles.Count}" Value="0">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </ItemsControl.Style>
                                             <ItemsControl.ItemsPanel>
                                                 <ItemsPanelTemplate>
                                                     <StackPanel/>
                                                 </ItemsPanelTemplate>
                                             </ItemsControl.ItemsPanel>
                                             <ItemsControl.ItemTemplate>
                                                 <DataTemplate>
                                                     <Grid Margin="0,4">
                                                         <!-- USER BUBBLE (right-aligned, cyan accent) -->
                                                         <Border HorizontalAlignment="Right" MaxWidth="290" CornerRadius="10,10,3,10" Padding="10,8" Margin="24,0,0,0"
                                                                 Background="#2200D2FF" BorderBrush="#4400D2FF" BorderThickness="1">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                             <Setter Property="Visibility" Value="Visible"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <StackPanel>
                                                                 <!-- Turn label -->
                                                                 <TextBlock Foreground="#9900D2FF" FontSize="9" FontWeight="Bold" Margin="0,0,0,5">
                                                                     <Run Text="📸 "/>
                                                                     <Run Text="{Binding TurnLabel, Mode=OneWay}"/>
                                                                 </TextBlock>
                                                                 <!-- Screenshot thumbnails row -->
                                                                 <ItemsControl ItemsSource="{Binding ScreenshotPreviews}" Margin="0,0,0,5">
                                                                     <ItemsControl.ItemsPanel>
                                                                         <ItemsPanelTemplate>
                                                                             <WrapPanel Orientation="Horizontal"/>
                                                                         </ItemsPanelTemplate>
                                                                     </ItemsControl.ItemsPanel>
                                                                     <ItemsControl.ItemTemplate>
                                                                         <DataTemplate>
                                                                             <Border CornerRadius="4" BorderBrush="#4000D2FF" BorderThickness="1" Background="#20000000" Width="54" Height="36" Margin="0,0,4,4" ClipToBounds="True">
                                                                                 <Image Source="{Binding}" Stretch="UniformToFill"/>
                                                                             </Border>
                                                                         </DataTemplate>
                                                                     </ItemsControl.ItemTemplate>
                                                                 </ItemsControl>
                                                                 <!-- Content text -->
                                                                 <TextBlock Text="{Binding Content}" Foreground="#E0FFFFFF" FontSize="9.5" TextWrapping="Wrap"/>
                                                             </StackPanel>
                                                         </Border>

                                                         <!-- ASSISTANT BUBBLE (left-aligned, darker bg) -->
                                                         <Border HorizontalAlignment="Left" MaxWidth="330" CornerRadius="10,10,10,3" Padding="10,8" Margin="0,0,24,0"
                                                                 Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                                             <Setter Property="Visibility" Value="Visible"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                             <Setter Property="Background" Value="#252A1515"/>
                                                                             <Setter Property="BorderBrush" Value="#55EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <StackPanel>
                                                                 <!-- Model info badge -->
                                                                 <Border Background="#14FFFFFF" CornerRadius="4" Padding="5,2" Margin="0,0,0,5" HorizontalAlignment="Left">
                                                                     <TextBlock Foreground="#8890CAF9" FontSize="8.5" FontWeight="SemiBold">
                                                                         <Run Text="🤖 "/>
                                                                         <Run Text="{Binding TurnLabel, Mode=OneWay}"/>
                                                                         <Run Text=" · "/>
                                                                         <Run Text="{Binding ModelInfo, Mode=OneWay}"/>
                                                                     </TextBlock>
                                                                 </Border>
                                                                 <!-- Loading indicator -->
                                                                 <Grid Margin="0,3,0,3" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                                                     <Grid.ColumnDefinitions>
                                                                         <ColumnDefinition Width="*"/>
                                                                         <ColumnDefinition Width="Auto"/>
                                                                     </Grid.ColumnDefinitions>
                                                                     <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                                         <TextBlock Text="⏳ " Foreground="#A0FFFFFF" FontSize="11"/>
                                                                         <TextBlock Text="{Binding Content}" Foreground="#A0FFFFFF" FontSize="10" FontStyle="Italic" TextWrapping="Wrap"/>
                                                                     </StackPanel>
                                                                     <!-- Red live timer on the right -->
                                                                     <Border Grid.Column="1" Background="#33FF3333" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                         <TextBlock Text="{Binding ElapsedLabel}" Foreground="#FFFF4444" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                                                     </Border>
                                                                 </Grid>
                                                                 <!-- Response content (hidden during loading) -->
                                                                 <TextBlock local:TextBlockHelper.FormattedText="{Binding Content}" Foreground="#F0FFFFFF" FontSize="{Binding DataContext.AppFontSize, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Background="Transparent">
                                                                     <TextBlock.Style>
                                                                         <Style TargetType="TextBlock">
                                                                             <Setter Property="Visibility" Value="Visible"/>
                                                                             <Style.Triggers>
                                                                                 <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                                 </DataTrigger>
                                                                             </Style.Triggers>
                                                                         </Style>
                                                                     </TextBlock.Style>
                                                                 </TextBlock>

                                                                 <!-- API Key / Environment Verification Action Bar -->
                                                                 <Border Margin="0,8,0,2" Padding="8,5" Background="#28EF4444" BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="5"
                                                                         Visibility="{Binding ShowCheckApiKeyAction, Converter={StaticResource BoolToVis}}">
                                                                     <DockPanel LastChildFill="True">
                                                                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                                             <TextBlock Text="⚠️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                             <TextBlock Text="API / Auth Error" Foreground="#FFFF8888" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                         </StackPanel>
                                                                         <Button Command="{Binding DataContext.OpenApiKeySettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 HorizontalAlignment="Right" Padding="8,2" Height="22"
                                                                                 Background="#40EF4444" Foreground="#FFFFEEEE" BorderBrush="#88EF4444" BorderThickness="1"
                                                                                 FontSize="9" FontWeight="Bold" Cursor="Hand">
                                                                             <Button.Template>
                                                                                 <ControlTemplate TargetType="Button">
                                                                                     <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                                                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                             <TextBlock Text="🔧 Check / Update Key" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"/>
                                                                                         </StackPanel>
                                                                                     </Border>
                                                                                 </ControlTemplate>
                                                                             </Button.Template>
                                                                         </Button>
                                                                     </DockPanel>
                                                                 </Border>
                                                             </StackPanel>
                                                         </Border>
                                                     </Grid>
                                                 </DataTemplate>
                                             </ItemsControl.ItemTemplate>
                                         </ItemsControl>
                                     </Grid>
                                 </ScrollViewer>
                             </Border>

                             <!-- Follow-up Question Area for Text Scan -->
                             <StackPanel Grid.Row="4" Margin="0,6,0,0" Visibility="{Binding IsFollowUpVisible, Converter={StaticResource BoolToVis}}">
                                  
                                  <!-- 7-Second Cooldown Timer Alert Banner -->
                                  <Border Background="#33FF4444" BorderBrush="#88FF5555" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,4"
                                          Visibility="{Binding IsFollowUpCooldownActive, Converter={StaticResource BoolToVis}}">
                                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                          <TextBlock Text="⏳" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                          <TextBlock Text="Please wait " Foreground="#FFAAAAAA" FontSize="10.5" VerticalAlignment="Center"/>
                                          <TextBlock Text="{Binding FollowUpCooldownSeconds}" Foreground="#FFFF5555" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                          <TextBlock Text="s before asking the next follow-up question" Foreground="#FFAAAAAA" FontSize="10.5" VerticalAlignment="Center"/>
                                      </StackPanel>
                                  </Border>

                                  <!-- Row 4: Follow-up Chat with Screenshot Button -->
                                  <StackPanel Grid.Row="4" Margin="0,4,0,0" Visibility="{Binding IsFollowUpVisible, Converter={StaticResource BoolToVis}}">
                                      <!-- 7s Cooldown Pill Badge -->
                                      <Border Background="#33FF4444" CornerRadius="4" Padding="6,3" Margin="0,0,0,4" HorizontalAlignment="Center"
                                              Visibility="{Binding IsFollowUpCooldownActive, Converter={StaticResource BoolToVis}}">
                                          <TextBlock Text="{Binding FollowUpCooldownText}" Foreground="#FFFF8888" FontSize="9.5" FontWeight="Bold"/>
                                      </Border>

                                      <!-- + ASK WITH SCREENSHOT Button -->
                                      <Button Command="{Binding StartScanCommand}" Cursor="Arrow" Height="30" Margin="0,2,0,0">
                                          <Button.Template>
                                              <ControlTemplate TargetType="Button">
                                                  <Border x:Name="AskBtnBorder" CornerRadius="6" Background="#2000D2FF" BorderBrush="#5000D2FF" BorderThickness="1" Padding="8,4">
                                                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                          <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="#00D2FF" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                                                          <TextBlock Text="📸 + ASK WITH SCREENSHOT" Foreground="#00D2FF" FontSize="9.5" FontWeight="Bold"/>
                                                      </StackPanel>
                                                  </Border>
                                                  <ControlTemplate.Triggers>
                                                      <Trigger Property="IsMouseOver" Value="True">
                                                          <Setter TargetName="AskBtnBorder" Property="Background" Value="#3500D2FF"/>
                                                          <Setter TargetName="AskBtnBorder" Property="BorderBrush" Value="#8000D2FF"/>
                                                      </Trigger>
                                                  </ControlTemplate.Triggers>
                                              </ControlTemplate>
                                          </Button.Template>
                                      </Button>

                                      <!-- Preset Quick Follow-up Question Pill Buttons (Dynamic per MCQ / Coding / Normal mode) -->
                                      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,4,0,2">
                                          <ItemsControl ItemsSource="{Binding PresetFollowUps}">
                                              <ItemsControl.ItemsPanel>
                                                  <ItemsPanelTemplate>
                                                      <StackPanel Orientation="Horizontal"/>
                                                  </ItemsPanelTemplate>
                                              </ItemsControl.ItemsPanel>
                                              <ItemsControl.ItemTemplate>
                                                  <DataTemplate>
                                                      <Button Command="{Binding DataContext.AskFollowUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                              CommandParameter="{Binding}" 
                                                              Cursor="Arrow" Margin="0,0,4,0">
                                                          <Button.Template>
                                                              <ControlTemplate TargetType="Button">
                                                                  <Border x:Name="PillBorder" CornerRadius="12" Background="#1800D2FF" BorderBrush="#3500D2FF" BorderThickness="1" Padding="10,4">
                                                                      <TextBlock Text="{Binding}" Foreground="#00D2FF" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                  </Border>
                                                                  <ControlTemplate.Triggers>
                                                                      <Trigger Property="IsMouseOver" Value="True">
                                                                          <Setter TargetName="PillBorder" Property="Background" Value="#3500D2FF"/>
                                                                          <Setter TargetName="PillBorder" Property="BorderBrush" Value="#7000D2FF"/>
                                                                      </Trigger>
                                                                  </ControlTemplate.Triggers>
                                                              </ControlTemplate>
                                                          </Button.Template>
                                                      </Button>
                                                  </DataTemplate>
                                              </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                      </ScrollViewer>

                                      <!-- Follow-up Text Input + Send Button -->
                                      <DockPanel Margin="0,4,0,0">
                                          <!-- Send Button -->
                                          <Button DockPanel.Dock="Right" Command="{Binding SubmitFollowUpCommand}" Cursor="Arrow" Width="40" Height="28" Margin="4,0,0,0">
                                              <Button.Template>
                                                  <ControlTemplate TargetType="Button">
                                                      <Border x:Name="SendBtnBorder" CornerRadius="6" Background="#2000D2FF" BorderBrush="#4000D2FF" BorderThickness="1">
                                                          <TextBlock Text="➤" Foreground="#00D2FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                      </Border>
                                                      <ControlTemplate.Triggers>
                                                          <Trigger Property="IsMouseOver" Value="True">
                                                              <Setter TargetName="SendBtnBorder" Property="Background" Value="#4000D2FF"/>
                                                          </Trigger>
                                                      </ControlTemplate.Triggers>
                                                  </ControlTemplate>
                                              </Button.Template>
                                          </Button>
                                          <!-- Text Input -->
                                          <Border CornerRadius="6" Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1">
                                              <TextBox Text="{Binding FollowUpText, UpdateSourceTrigger=PropertyChanged}" 
                                                       Background="Transparent" Foreground="#F0FFFFFF" FontSize="10.5" 
                                                       BorderThickness="0" Padding="8,5" VerticalContentAlignment="Center"
                                                       CaretBrush="#00D2FF" AcceptsReturn="False">
                                                  <TextBox.InputBindings>
                                                      <KeyBinding Key="Return" Command="{Binding SubmitFollowUpCommand}"/>
                                                  </TextBox.InputBindings>
                                              </TextBox>
                                          </Border>
                                      </DockPanel>
                                  </StackPanel>           
                             </StackPanel>

                             <!-- Loader Spinner Bar -->
                             <ProgressBar Grid.Row="5" Height="4" IsIndeterminate="True" Background="#11FFFFFF" Foreground="{Binding Tag, ElementName=MainBorder}" Margin="0,6,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                         </Grid>
                     </Border>
                 </Grid>

                <!-- VOICE SCAN WIDGET -->
                <Grid Visibility="{Binding IsVoiceScanActive, Converter={StaticResource BoolToVis}}">
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Row 0: Option Toggles -->
                                <RowDefinition Height="Auto"/> <!-- Row 1: Record Control -->
                                <RowDefinition Height="*"/>    <!-- Row 2: Response Area -->
                                <RowDefinition Height="Auto"/> <!-- Row 3: Follow-up Chat Box -->
                                <RowDefinition Height="Auto"/> <!-- Row 4: Loader ProgressBar -->
                            </Grid.RowDefinitions>

                            <!-- Option Toggles (Audio Source and Live Mode) -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Audio Source -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="SOURCE:" VerticalAlignment="Center" Foreground="#99FFFFFF" FontSize="9" FontWeight="Bold" Margin="0,0,5,0"/>
                                    <RadioButton Content="MIC" Style="{StaticResource SegmentButtonStyle}" GroupName="VoiceSource" IsChecked="{Binding IsMicrophoneSource, Mode=TwoWay}"/>
                                    <RadioButton Content="SYSTEM" Style="{StaticResource SegmentButtonStyle}" GroupName="VoiceSource" IsChecked="{Binding IsSystemAudioSource, Mode=TwoWay}"/>
                                </StackPanel>

                                <!-- Right Column: Recording Mode -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="MODE:" VerticalAlignment="Center" Foreground="#99FFFFFF" FontSize="9" FontWeight="Bold" Margin="0,0,5,0"/>
                                    <RadioButton Content="MANUAL" Style="{StaticResource SegmentButtonStyle}" GroupName="VoiceMode" IsChecked="{Binding IsManualMode, Mode=TwoWay}"/>
                                    <RadioButton Content="LIVE AUTO" Style="{StaticResource SegmentButtonStyle}" GroupName="VoiceMode" IsChecked="{Binding IsLiveMode, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                             <!-- Voice Controls Row -->
                             <Grid Grid.Row="1" Margin="0,0,0,8">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*"/>
                                     <ColumnDefinition Width="Auto"/>
                                     <ColumnDefinition Width="Auto"/>
                                 </Grid.ColumnDefinitions>

                                 <!-- Voice Record Button -->
                                 <Button Grid.Column="0" Command="{Binding ToggleVoiceCommand}" Cursor="Arrow" Height="32" Margin="0,0,4,0">
                                     <Button.Style>
                                         <Style TargetType="Button">
                                             <Setter Property="Template">
                                                 <Setter.Value>
                                                     <ControlTemplate TargetType="Button">
                                                         <Border CornerRadius="7" Background="#22FFFFFF" BorderBrush="{Binding Tag, ElementName=MainBorder}" BorderThickness="1" Padding="8,4">
                                                             <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                 <Path Data="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7z" 
                                                                       Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                                 <TextBlock Text="{Binding VoiceBtnText}" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold"/>
                                                             </StackPanel>
                                                         </Border>
                                                         <ControlTemplate.Triggers>
                                                             <Trigger Property="IsMouseOver" Value="True">
                                                                 <Setter Property="Opacity" Value="0.92"/>
                                                             </Trigger>
                                                         </ControlTemplate.Triggers>
                                                     </ControlTemplate>
                                                 </Setter.Value>
                                             </Setter>
                                             <Style.Triggers>
                                                 <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                     <Setter Property="Template">
                                                         <Setter.Value>
                                                             <ControlTemplate TargetType="Button">
                                                                 <Border CornerRadius="7" Background="#FFFF453A" Padding="8,4">
                                                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                         <Path Data="M6 19h12V5H6v14z" 
                                                                               Fill="#000000" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                                         <TextBlock Text="{Binding VoiceBtnText}" Foreground="#000000" FontSize="10.5" FontWeight="Bold"/>
                                                                     </StackPanel>
                                                                 </Border>
                                                             </ControlTemplate>
                                                         </Setter.Value>
                                                     </Setter>
                                                 </DataTrigger>
                                             </Style.Triggers>
                                         </Style>
                                     </Button.Style>
                                 </Button>

                                 <!-- Copy Button -->
                                 <Button Grid.Column="1" Command="{Binding CopyVoiceCommand}" Cursor="Arrow" Height="32" Width="32" Margin="0,0,4,0">
                                     <Button.Template>
                                         <ControlTemplate TargetType="Button">
                                             <Border x:Name="VoiceCopyBorder" CornerRadius="4" Background="#18FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="4">
                                                 <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" 
                                                       Fill="#88FFFFFF" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                             </Border>
                                             <ControlTemplate.Triggers>
                                                 <Trigger Property="IsMouseOver" Value="True">
                                                     <Setter TargetName="VoiceCopyBorder" Property="Background" Value="#28FFFFFF"/>
                                                 </Trigger>
                                             </ControlTemplate.Triggers>
                                         </ControlTemplate>
                                     </Button.Template>
                                 </Button>

                                 <!-- Clear/Refresh Button -->
                                 <Button Grid.Column="2" Command="{Binding ClearVoiceScanCommand}" Cursor="Arrow" Height="32" Width="32">
                                     <Button.Template>
                                         <ControlTemplate TargetType="Button">
                                             <Border x:Name="VoiceClearBorder" CornerRadius="4" Background="#18FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="4">
                                                 <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" 
                                                       Fill="#88FFFFFF" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                             </Border>
                                             <ControlTemplate.Triggers>
                                                 <Trigger Property="IsMouseOver" Value="True">
                                                     <Setter TargetName="VoiceClearBorder" Property="Background" Value="#28FFFFFF"/>
                                                 </Trigger>
                                             </ControlTemplate.Triggers>
                                         </ControlTemplate>
                                     </Button.Template>
                                 </Button>
                             </Grid>

                            <!-- Voice Response Area (Chat Bubble Style with Fallback) -->
                            <Border Grid.Row="2" Background="#0AFFFFFF" CornerRadius="6" Padding="3">
                                <ScrollViewer x:Name="VoiceScanScrollViewer" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                                    <Grid>
                                        <!-- Fallback: plain VoiceScanResponseText when no chat bubbles exist yet -->
                                        <TextBlock local:TextBlockHelper.FormattedText="{Binding VoiceScanResponseText}" Foreground="#E0FFFFFF" FontSize="{Binding AppFontSize}" TextWrapping="Wrap" Background="Transparent" Padding="6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VoiceChatBubbles.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Chat Bubbles ItemsControl -->
                                        <ItemsControl ItemsSource="{Binding VoiceChatBubbles}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VoiceChatBubbles.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <!-- USER BUBBLE (right-aligned, violet accent) -->
                                                        <Border HorizontalAlignment="Right" MaxWidth="290" CornerRadius="10,10,3,10" Padding="10,8" Margin="24,0,0,0"
                                                                Background="#257C4DFF" BorderBrush="#50B388FF" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <!-- Turn label -->
                                                                <TextBlock Foreground="#D1C4E9" FontSize="9" FontWeight="Bold" Margin="0,0,0,4">
                                                                    <Run Text="🎙️ "/>
                                                                    <Run Text="{Binding TurnLabel, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <!-- Content text -->
                                                                <TextBlock Text="{Binding Content}" Foreground="#EDE7F6" FontSize="10" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- ASSISTANT BUBBLE (left-aligned, darker bg) -->
                                                        <Border HorizontalAlignment="Left" MaxWidth="330" CornerRadius="10,10,10,3" Padding="10,8" Margin="0,0,24,0"
                                                                Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                            <Setter Property="Background" Value="#252A1515"/>
                                                                            <Setter Property="BorderBrush" Value="#55EF4444"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <!-- Model info badge -->
                                                                <Border Background="#14FFFFFF" CornerRadius="4" Padding="5,2" Margin="0,0,0,5" HorizontalAlignment="Left">
                                                                    <TextBlock Foreground="#8890CAF9" FontSize="8.5" FontWeight="SemiBold">
                                                                        <Run Text="🤖 "/>
                                                                        <Run Text="{Binding TurnLabel, Mode=OneWay}"/>
                                                                        <Run Text=" · "/>
                                                                        <Run Text="{Binding ModelInfo, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </Border>
                                                                <!-- Loading indicator -->
                                                                <Grid Margin="0,3,0,3" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                                        <TextBlock Text="⏳ " Foreground="#A0FFFFFF" FontSize="11"/>
                                                                        <TextBlock Text="{Binding Content}" Foreground="#A0FFFFFF" FontSize="10" FontStyle="Italic" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                    <!-- Red live timer on the right -->
                                                                    <Border Grid.Column="1" Background="#33FF3333" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ElapsedLabel}" Foreground="#FFFF4444" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                                                    </Border>
                                                                </Grid>
                                                                <!-- Response content (hidden during loading) -->
                                                                <TextBlock local:TextBlockHelper.FormattedText="{Binding Content}" Foreground="#F0FFFFFF" FontSize="{Binding DataContext.AppFontSize, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Background="Transparent">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <!-- API Key / Environment Verification Action Bar -->
                                                                <Border Margin="0,8,0,2" Padding="8,5" Background="#28EF4444" BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="5"
                                                                        Visibility="{Binding ShowCheckApiKeyAction, Converter={StaticResource BoolToVis}}">
                                                                    <DockPanel LastChildFill="True">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                                            <TextBlock Text="⚠️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="API / Auth Error" Foreground="#FFFF8888" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <Button Command="{Binding DataContext.OpenApiKeySettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                HorizontalAlignment="Right" Padding="8,2" Height="22"
                                                                                Background="#40EF4444" Foreground="#FFFFEEEE" BorderBrush="#88EF4444" BorderThickness="1"
                                                                                FontSize="9" FontWeight="Bold" Cursor="Hand">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <TextBlock Text="🔧 Check / Update Key" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"/>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                    </DockPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <!-- Follow-up Question Area for Voice Scan -->
                            <StackPanel Grid.Row="3" Margin="0,6,0,0" Visibility="{Binding IsFollowUpVisible, Converter={StaticResource BoolToVis}}">
                                <!-- Preset Quick Follow-up Question Pill Buttons -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                                    <ItemsControl ItemsSource="{Binding PresetFollowUps}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.AskFollowUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        Cursor="Arrow" Margin="0,0,4,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="PillBorder" CornerRadius="12" Background="#187C4DFF" BorderBrush="#35B388FF" BorderThickness="1" Padding="10,4">
                                                                <TextBlock Text="{Binding}" Foreground="#B388FF" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="PillBorder" Property="Background" Value="#357C4DFF"/>
                                                                    <Setter TargetName="PillBorder" Property="BorderBrush" Value="#70B388FF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Follow-up Input Bar -->
                                <Border Background="#14FFFFFF" CornerRadius="6" Padding="6,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Chat Input TextBox -->
                                        <TextBox Grid.Column="0" Text="{Binding FollowUpText, UpdateSourceTrigger=PropertyChanged}" 
                                                 Foreground="#F0FFFFFF" FontSize="10.5" Background="Transparent" BorderThickness="0" 
                                                 VerticalContentAlignment="Center" Margin="4,2" CaretBrush="#FFFFFF" SelectionBrush="{Binding Tag, ElementName=MainBorder}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding SubmitFollowUpCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>

                                        <!-- 7-Second Cooldown Timer Badge -->
                                        <Border Grid.Column="1" Background="#33FF4444" CornerRadius="4" Padding="6,2" Margin="2,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsFollowUpCooldownActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding FollowUpCooldownText}" Foreground="#FFFF8888" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Follow-up Microphone Button (takes external mic only) -->
                                        <Button Grid.Column="2" Command="{Binding ToggleFollowUpVoiceCommand}" Cursor="Arrow" Background="Transparent" BorderThickness="0" Margin="2,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" Padding="5">
                                                        <!-- Simple mic SVG -->
                                                        <Path x:Name="MicIcon" Data="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7z" 
                                                              Fill="{Binding FollowUpMicColor}" Width="12" Height="12" Stretch="Uniform"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Send Button -->
                                        <Button Grid.Column="3" Command="{Binding SubmitFollowUpCommand}" Cursor="Arrow" Background="Transparent" BorderThickness="0" Margin="2,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" Padding="5">
                                                        <!-- Simple paper plane Send SVG -->
                                                        <Path x:Name="SendIcon" Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" 
                                                              Fill="#88FFFFFF" Width="12" Height="12" Stretch="Uniform"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SendIcon" Property="Fill" Value="{Binding Tag, ElementName=MainBorder}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Loader Spinner Bar -->
                            <ProgressBar Grid.Row="4" Height="4" IsIndeterminate="True" Background="#11FFFFFF" Foreground="{Binding Tag, ElementName=MainBorder}" Margin="0,6,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- PROFILE WIDGET -->
                <Grid Visibility="{Binding IsProfileActive, Converter={StaticResource BoolToVis}}">
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="14">
                        <StackPanel VerticalAlignment="Center">
                            <!-- Avatar circle -->
                            <Border Width="46" Height="46" CornerRadius="23" Background="#2500FFCC" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="👤" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ACCOUNT PROFILE" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            
                            <!-- Info Cards Container -->
                            <Border Background="#0CFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <!-- Name Row -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Name" Foreground="#88FFFFFF" FontSize="11" Width="70" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProfileName}" Foreground="{Binding Tag, ElementName=MainBorder}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Email Row -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Email" Foreground="#88FFFFFF" FontSize="11" Width="70" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UserEmail}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Groq Key Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Groq Key" Foreground="#88FFFFFF" FontSize="11" Width="70" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MaskedGroqKey}" Foreground="#E0FFFFFF" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <TextBlock Text="To edit your key, please use the settings drawer or log out and log back in." Foreground="#66FFFFFF" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,8"/>

                            <!-- Version & Update Section -->
                            <Border Background="#0CFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,2,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Version" Foreground="#88FFFFFF" FontSize="11" Width="70" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#18FFFFFF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentAppVersion, StringFormat=v{0}}" Foreground="#AAFFFFFF" FontSize="10" FontFamily="Consolas" FontWeight="Bold"/>
                                    </Border>
                                    <!-- Check for update link -->
                                    <Button Grid.Column="2" Command="{Binding CheckForUpdateCommand}"
                                            Background="Transparent" BorderThickness="0" Cursor="Arrow" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="4" Background="#14FFFFFF" Padding="6,3">
                                                    <TextBlock Text="🔄 Check" Foreground="#90CAF9" FontSize="9.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Update available banner -->
                            <Border Background="#2500D2FF" BorderBrush="#5000D2FF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,4,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Foreground="#00D2FF" FontSize="10.5" FontWeight="Bold" TextWrapping="Wrap">
                                        <Run Text="🆕 Update available: v"/>
                                        <Run Text="{Binding LatestVersion}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding UpdateReleaseNotes}" Foreground="#AAFFFFFF" FontSize="9.5" TextWrapping="Wrap" Margin="0,3,0,6"
                                               Visibility="{Binding UpdateReleaseNotes, Converter={StaticResource StringToVisConverter}}"/>

                                    <!-- Progress bar (shown during download) -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <ProgressBar Value="{Binding UpdateProgress, Mode=OneWay}" Maximum="1" Height="6" Background="#22FFFFFF" Foreground="#00D2FF" BorderThickness="0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding UpdateStatusText}" Foreground="#AAFFFFFF" FontSize="9.5" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Update button -->
                                    <Button Command="{Binding DownloadUpdateCommand}" Cursor="Arrow" Height="28"
                                            Visibility="{Binding ShowDownloadButton, Converter={StaticResource BoolToVis}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="6" Background="#CC00D2FF" BorderThickness="0" Padding="8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                                                                    <Setter Property="Background" Value="#FF00D2FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="⬇ DOWNLOAD UPDATE" Foreground="#FF000000" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Restart to Apply button (shown after download completes) -->
                                    <Button Command="{Binding ApplyUpdateCommand}" Cursor="Arrow" Height="28"
                                            Visibility="{Binding ShowRestartButton, Converter={StaticResource BoolToVis}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="6" Background="#CC00FFCC" BorderThickness="0" Padding="8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                                                                    <Setter Property="Background" Value="#FF00FFCC"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="🔄 RESTART TO APPLY" Foreground="#FF000000" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Up to date message -->
                            <TextBlock Foreground="#8800FFCC" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" Text="✅ App is up to date">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding UpdateAvailable}" Value="False"/>
                                                    <Condition Binding="{Binding LatestVersion}" Value=""/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding UpdateAvailable}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Settings Drawer (Collapsible) -->
            <Grid Grid.Row="3">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Border BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Background="#0AFFFFFF">
                    <Grid Margin="12,10,12,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚙  SETTINGS" Foreground="#77FFFFFF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding ToggleSettingsCommand}" Background="Transparent" BorderThickness="0" Cursor="Arrow">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="4">
                                            <Path x:Name="Icon" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                                  Fill="#66FFFFFF" Width="10" Height="10" Stretch="Uniform"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Icon" Property="Fill" Value="#FFFF453A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Opacity Slider -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Opacity" Foreground="#88FFFFFF" FontSize="10.5" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0.1" Maximum="1.0" Value="{Binding WindowOpacity, Mode=TwoWay}" 
                                    Style="{StaticResource SleekSliderStyle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding WindowOpacity, StringFormat={}{0:P0}}" 
                                       Foreground="#88FFFFFF" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Font Size Slider -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Text" Foreground="#88FFFFFF" FontSize="10.5" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="8.0" Maximum="22.0" Value="{Binding AppFontSize, Mode=TwoWay}" 
                                    Style="{StaticResource SleekSliderStyle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding AppFontSize, StringFormat={}{0:F0}pt}" 
                                       Foreground="#88FFFFFF" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Toggles -->
                        <Grid Grid.Row="3" Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="Always on Top" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" Style="{StaticResource ToggleSwitchStyle}"/>
                            <CheckBox Grid.Column="1" Content="Lock Position" IsChecked="{Binding IsLocked, Mode=TwoWay}" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Theme -->
                        <Grid Grid.Row="4" Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Theme" Foreground="#88FFFFFF" FontSize="10.5" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Command="{Binding ChangeThemeCommand}" CommandParameter="Onyx" IsChecked="True" Cursor="Arrow" Margin="3,0">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#FF00D2FF" BorderBrush="#FFFFFF" BorderThickness="0" Margin="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked}" Value="True">
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                                <RadioButton Command="{Binding ChangeThemeCommand}" CommandParameter="Neon" Cursor="Arrow" Margin="3,0">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#FFFF00A0" BorderBrush="#FFFFFF" BorderThickness="0" Margin="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked}" Value="True">
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                                <RadioButton Command="{Binding ChangeThemeCommand}" CommandParameter="Emerald" Cursor="Arrow" Margin="3,0">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#FF00FFCC" BorderBrush="#FFFFFF" BorderThickness="0" Margin="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked}" Value="True">
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                                <RadioButton Command="{Binding ChangeThemeCommand}" CommandParameter="Sunset" Cursor="Arrow" Margin="3,0">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#FFFF7700" BorderBrush="#FFFFFF" BorderThickness="0" Margin="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked}" Value="True">
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </StackPanel>
                        </Grid>

                        <!-- API Keys -->
                        <StackPanel Grid.Row="5" Margin="0,4,0,6">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="API PROVIDER" Foreground="#66FFFFFF" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <RadioButton Content="Groq" GroupName="ApiProviderGroup" IsChecked="{Binding IsGroqApiActive, Mode=TwoWay}" Cursor="Arrow" Margin="0,0,8,0" Foreground="#AAFFFFFF" FontSize="9.5"/>
                                    <RadioButton Content="Gemini" GroupName="ApiProviderGroup" IsChecked="{Binding IsGeminiApiActive, Mode=TwoWay}" Cursor="Arrow" Foreground="#AAFFFFFF" FontSize="9.5"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid Margin="0,2,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Groq Key" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6">
                                    <TextBox x:Name="GroqSettingsKeyBox" Text="{Binding GroqKey, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" BorderThickness="0" 
                                             Foreground="#E0FFFFFF" Padding="8,4" FontSize="10"
                                             VerticalContentAlignment="Center" CaretBrush="#FFFFFF"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Gemini Key" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6">
                                    <TextBox x:Name="GeminiSettingsKeyBox" Text="{Binding GeminiKey, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" BorderThickness="0" 
                                             Foreground="#E0FFFFFF" Padding="8,4" FontSize="10"
                                             VerticalContentAlignment="Center" CaretBrush="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Hint -->
                        <TextBlock Grid.Row="6" Text="Ctrl+Shift+C — exit click-through mode" 
                                   Foreground="#44FFFFFF" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                        <!-- Logout -->
                        <Button Grid.Row="7" Command="{Binding LogoutCommand}" Margin="0,10,0,0" Height="28" Cursor="Arrow">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="7" Background="#20FF3333" BorderBrush="#40FF3333" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" Fill="#FFFF7777" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="LOGOUT" Foreground="#FFFF7777" FontSize="9.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!--   MANDATORY GROQ & GEMINI API KEYS OVERLAY -->
            <!-- ========================================== -->
            <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="999" Background="#FF0B0F19" Visibility="{Binding IsGroqKeyOverlayVisible, Converter={StaticResource BoolToVis}}">
                <Border Width="360" Height="480" CornerRadius="18" Background="#18FFFFFF" BorderThickness="1.2" BorderBrush="#35FFFFFF" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="Black" Opacity="0.65"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <!-- Back Button to log out / change account -->
                            <Button Command="{Binding LogoutCommand}" Content="← Back" Foreground="#CCFFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Cursor="Arrow" Margin="0,-4,0,0"/>

                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="44" Height="44" CornerRadius="22" Background="#2500D2FF" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="🔑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="API KEYS SETUP" Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Setup your Groq &amp; Google Gemini API keys to activate dual-model AI OCR &amp; analysis." Foreground="#AAFFFFFF" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Inputs Section -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2">
                            <!-- Groq Key Section -->
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="1. GROQ API KEY" Foreground="#00D2FF" FontSize="10.5" FontWeight="Bold" DockPanel.Dock="Left"/>
                                <Button Command="{Binding OpenGroqConsoleCommand}" Cursor="Arrow" Background="Transparent" BorderThickness="0" DockPanel.Dock="Right">
                                    <TextBlock Text="🌐 console.groq.com/keys" Foreground="#99FFFFFF" FontSize="9.5" TextDecorations="Underline"/>
                                </Button>
                            </DockPanel>
                            <Border CornerRadius="7" Background="#30000000" BorderThickness="1" BorderBrush="#35FFFFFF" Padding="10,6" Margin="0,0,0,10">
                                <TextBox Text="{Binding GroqInputKey, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11" CaretBrush="#FFFFFF" VerticalContentAlignment="Center"/>
                            </Border>

                            <!-- Gemini Key Section -->
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="2. GOOGLE GEMINI API KEY" Foreground="#4285F4" FontSize="10.5" FontWeight="Bold" DockPanel.Dock="Left"/>
                                <Button Command="{Binding OpenGeminiConsoleCommand}" Cursor="Arrow" Background="Transparent" BorderThickness="0" DockPanel.Dock="Right">
                                    <TextBlock Text="🌐 aistudio.google.com" Foreground="#99FFFFFF" FontSize="9.5" TextDecorations="Underline"/>
                                </Button>
                            </DockPanel>
                            <Border CornerRadius="7" Background="#30000000" BorderThickness="1" BorderBrush="#35FFFFFF" Padding="10,6" Margin="0,0,0,12">
                                <TextBox Text="{Binding GeminiInputKey, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11" CaretBrush="#FFFFFF" VerticalContentAlignment="Center"/>
                            </Border>

                            <!-- Default API Provider Selector -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="PRIMARY API PROVIDER:" Foreground="#99FFFFFF" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <RadioButton Content="Groq" GroupName="EntranceApiProviderGroup" IsChecked="{Binding IsGroqApiActive, Mode=TwoWay}" Cursor="Arrow" Margin="0,0,10,0" Foreground="#CCFFFFFF" FontSize="10"/>
                                    <RadioButton Content="Gemini" GroupName="EntranceApiProviderGroup" IsChecked="{Binding IsGeminiApiActive, Mode=TwoWay}" Cursor="Arrow" Foreground="#CCFFFFFF" FontSize="10"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Error Message -->
                            <TextBlock Text="{Binding GroqKeyValidationError}" Foreground="#FFFF5555" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Row="2">
                            <!-- Loading Text -->
                            <TextBlock Text="Verifying API Keys..." Foreground="#00D2FF" FontSize="10.5" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValidatingGroqKey}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Verify Button -->
                            <Button Command="{Binding ValidateApiKeysCommand}" Content="VERIFY &amp; SAVE KEYS" Height="38" FontWeight="Bold" Cursor="Arrow" Foreground="#FFFFFF" FontSize="12">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#FF00D2FF"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF33E0FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!--            DASHBOARD OVERLAY               -->
            <!-- ========================================== -->
            <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="997" Background="#FF0B0F19" Visibility="{Binding IsDashboardOverlayVisible, Converter={StaticResource BoolToVis}}">
                <Border Width="360" Height="430" CornerRadius="18" Background="#18FFFFFF" BorderThickness="1.2" BorderBrush="#35FFFFFF" Padding="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="Black" Opacity="0.65"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Border Width="46" Height="46" CornerRadius="23" Background="#2500FFCC" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="SHADOW AI DASHBOARD" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Next-Generation Invisible Productivity &amp; Exam Overlay" Foreground="#AAFFFFFF" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Status Overview Cards -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4">
                            <!-- Groq Key Status -->
                            <Border CornerRadius="8" Background="#18FFFFFF" BorderThickness="1" BorderBrush="#25FFFFFF" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Groq API Key Status" Foreground="#88FFFFFF" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Connected &amp; Verified ✅" Foreground="#00FFCC" FontSize="11.5" FontWeight="Bold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Anti-Detection Status -->
                            <Border CornerRadius="8" Background="#18FFFFFF" BorderThickness="1" BorderBrush="#25FFFFFF" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Anti-Detection Shield" Foreground="#88FFFFFF" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="OS WS_EX_NOACTIVATE &amp; Tampermonkey Active ✅" Foreground="#00FFCC" FontSize="11" FontWeight="Bold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Gate Info -->
                            <TextBlock Text="Core app features are currently locked until you start your trial." Foreground="#B0B0B0" FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Action Button -->
                        <StackPanel Grid.Row="2">
                            <Button Command="{Binding StartFreeTrialCommand}" Content="🚀 START FREE TRIAL" Height="40" FontWeight="Bold" Cursor="Arrow" Foreground="#000000" FontSize="12">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#FF00FFCC"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF55FFDD"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- First-Launch Onboarding Carousel Overlay -->
            <Grid Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                <!-- Solid dark glass background -->
                <Border Background="#F90B0E18" CornerRadius="0,0,14,14" BorderBrush="{Binding Tag, ElementName=MainBorder}" BorderThickness="0,1,0,0">
                    <Grid Margin="20,18,20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Slide Deck Content Area -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <!-- SLIDE 0: Welcome -->
                            <Grid Visibility="{Binding IsSlide0Active, Converter={StaticResource BoolToVis}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="56" Height="56" CornerRadius="28" Background="#15FFFFFF" BorderBrush="{Binding Tag, ElementName=MainBorder}" BorderThickness="1.2" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <Path Data="M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5M2 12l10 5 10-5" 
                                              Fill="{Binding Tag, ElementName=MainBorder}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Welcome to Shadow AI" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <Border Background="#18FFFFFF" CornerRadius="4" Padding="8,2" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="NEXT-GEN DESKTOP OVERLAY" Foreground="{Binding Tag, ElementName=MainBorder}" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Ultra-fast glassmorphic HUD for live interview assistance, notes, system metrics, and screen OCR." 
                                               Foreground="#9EABB8" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="250" HorizontalAlignment="Center" LineHeight="16"/>
                                </StackPanel>
                            </Grid>

                            <!-- SLIDE 1: AI Screen Crop Scanner -->
                            <Grid Visibility="{Binding IsSlide1Active, Converter={StaticResource BoolToVis}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="46" Height="46" CornerRadius="23" Background="#15FFFFFF" BorderBrush="{Binding Tag, ElementName=MainBorder}" BorderThickness="1.2" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <Path Data="M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5M2 12l10 5 10-5" 
                                              Fill="{Binding Tag, ElementName=MainBorder}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="AI &amp; Performance Utilities" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    
                                    <StackPanel Width="250">
                                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="8,5" Margin="0,2">
                                            <TextBlock Text="⚡ Sub-second Groq Llama 3 responses" Foreground="#E0E6ED" FontSize="10.5"/>
                                        </Border>
                                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="8,5" Margin="0,2">
                                            <TextBlock Text="🎯 Interactive screen crop OCR analysis" Foreground="#E0E6ED" FontSize="10.5"/>
                                        </Border>
                                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="8,5" Margin="0,2">
                                            <TextBlock Text="🛡️ Stream-safe coding interview overlays" Foreground="#E0E6ED" FontSize="10.5"/>
                                        </Border>
                                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="8,5" Margin="0,2">
                                            <TextBlock Text="🎙️ Real-time speech transcription (Whisper)" Foreground="#E0E6ED" FontSize="10.5"/>
                                        </Border>
                                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="8,5" Margin="0,2">
                                            <TextBlock Text="💾 Local SQLite database session storage" Foreground="#E0E6ED" FontSize="10.5"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- SLIDE 2: Pinning, Mouse Click-Through & Hotkey -->
                            <Grid Visibility="{Binding IsSlide2Active, Converter={StaticResource BoolToVis}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="46" Height="46" CornerRadius="23" Background="#15FFFFFF" BorderBrush="{Binding Tag, ElementName=MainBorder}" BorderThickness="1.2" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" 
                                              Fill="{Binding Tag, ElementName=MainBorder}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Security &amp; Stealth Protections" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    
                                    <StackPanel Width="250">
                                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="8,5" Margin="0,2">
                                            <TextBlock Text="🔒 Invisible on OBS &amp; Discord screen shares" Foreground="#E0E6ED" FontSize="10.5"/>
                                        </Border>
                                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="8,5" Margin="0,2">
                                            <TextBlock Text="👻 Invisible in Dock (no taskbar icon)" Foreground="#E0E6ED" FontSize="10.5"/>
                                        </Border>
                                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="8,5" Margin="0,2">
                                            <TextBlock Text="🛡️ Invisible in Task Manager (masqueraded)" Foreground="#E0E6ED" FontSize="10.5"/>
                                        </Border>
                                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="8,5" Margin="0,2">
                                            <TextBlock Text="🚫 Excluded from Alt+Tab switcher menu" Foreground="#E0E6ED" FontSize="10.5"/>
                                        </Border>
                                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="8,5" Margin="0,2">
                                            <TextBlock Text="🖱️ Cursor Undetectability (Ctrl+Shift+C)" Foreground="#E0E6ED" FontSize="10.5"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- SLIDE 3: Key Configuration and Finish -->
                            <Grid Visibility="{Binding IsSlide3Active, Converter={StaticResource BoolToVis}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="#15FFFFFF" BorderBrush="{Binding Tag, ElementName=MainBorder}" BorderThickness="1.2" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <Path Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" 
                                              Fill="{Binding Tag, ElementName=MainBorder}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Configure Groq API Key" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Enter your free API key for sub-second responses." Foreground="#8E9BAE" FontSize="10.5" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    
                                    <!-- Groq Key TextBox -->
                                    <Grid Margin="0,4,0,12" Width="240">
                                        <TextBox x:Name="GroqOnboardingKeyBox" Text="{Binding GroqKey, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" 
                                                 Foreground="#FFFFFF" Padding="10,6" FontSize="11"
                                                 VerticalContentAlignment="Center" CaretBrush="#FFFFFF">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <TextBlock Text="Paste Groq API Key (Optional)..." Foreground="#55FFFFFF" FontSize="11" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=GroqOnboardingKeyBox, Path=Text}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Finish Button -->
                                    <Button Command="{Binding FinishOnboardingCommand}" Cursor="Arrow" Width="150" Height="34">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="8" Background="{Binding Tag, ElementName=MainBorder}" Padding="10,6">
                                                    <TextBlock Text="GET STARTED" Foreground="#000000" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Bottom Navigation Actions -->
                        <Grid Grid.Row="1" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Back Button -->
                            <Button Grid.Column="0" Command="{Binding BackOnboardingCommand}" Content="← BACK" Foreground="#8E9BAE" FontSize="10.5" FontWeight="Bold" Cursor="Arrow" VerticalAlignment="Center" Padding="8,4">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#15FFFFFF"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding CurrentOnboardingSlide}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Center Slide Indicators -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Dot 0 -->
                                <Border Width="8" Height="6" CornerRadius="3" Margin="3,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#25FFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentOnboardingSlide}" Value="0">
                                                    <Setter Property="Background" Value="{Binding Tag, ElementName=MainBorder}"/>
                                                    <Setter Property="Width" Value="18"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <!-- Dot 1 -->
                                <Border Width="8" Height="6" CornerRadius="3" Margin="3,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#25FFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentOnboardingSlide}" Value="1">
                                                    <Setter Property="Background" Value="{Binding Tag, ElementName=MainBorder}"/>
                                                    <Setter Property="Width" Value="18"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <!-- Dot 2 -->
                                <Border Width="8" Height="6" CornerRadius="3" Margin="3,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#25FFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentOnboardingSlide}" Value="2">
                                                    <Setter Property="Background" Value="{Binding Tag, ElementName=MainBorder}"/>
                                                    <Setter Property="Width" Value="18"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <!-- Dot 3 -->
                                <Border Width="8" Height="6" CornerRadius="3" Margin="3,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#25FFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentOnboardingSlide}" Value="3">
                                                    <Setter Property="Background" Value="{Binding Tag, ElementName=MainBorder}"/>
                                                    <Setter Property="Width" Value="18"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </StackPanel>

                            <!-- Next/Skip Buttons -->
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <!-- Next Button -->
                                <Button Command="{Binding NextOnboardingCommand}" Content="NEXT →" Foreground="{Binding Tag, ElementName=MainBorder}" FontSize="10.5" FontWeight="Bold" Cursor="Arrow" Padding="8,4">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#15FFFFFF"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding CurrentOnboardingSlide}" Value="3">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!--            LOGIN / SIGNUP OVERLAY          -->
            <!-- ========================================== -->
            <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="999" Background="#F0080B14">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoginOverlayVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Width="310" MinHeight="340" Height="Auto" CornerRadius="18" Background="#F80F1424" BorderThickness="1.2" BorderBrush="#25FFFFFF" Padding="24,22" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="2" Color="Black" Opacity="0.6"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Center" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#14FFFFFF" BorderBrush="{Binding Tag, ElementName=MainBorder}" BorderThickness="1.2" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Path Data="M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5M2 12l10 5 10-5" 
                                          Fill="{Binding Tag, ElementName=MainBorder}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="SHADOW AI" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Enter credentials to activate overlay" Foreground="#8E9BAE" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Form -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="EMAIL ADDRESS" Foreground="#8E9BAE" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Border CornerRadius="8" Background="#14FFFFFF" BorderThickness="1" BorderBrush="#22FFFFFF" Padding="10,6" Margin="0,0,0,12">
                                <TextBox Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11.5" CaretBrush="#FFFFFF"/>
                            </Border>

                            <TextBlock Text="PASSWORD" Foreground="#8E9BAE" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Border CornerRadius="8" Background="#14FFFFFF" BorderThickness="1" BorderBrush="#22FFFFFF" Padding="10,6" Margin="0,0,0,12">
                                <TextBox Text="{Binding LoginPassword, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11.5" CaretBrush="#FFFFFF"/>
                            </Border>
                        </StackPanel>

                        <!-- Error / Loading -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="{Binding AuthErrorMessage}" Foreground="#FFFF4444" FontSize="10.5" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Processing request..." Foreground="{Binding Tag, ElementName=MainBorder}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAuthLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Buttons -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Command="{Binding LoginCommand}" Content="LOGIN" Margin="0,0,5,0" Height="34" FontWeight="Bold" Cursor="Arrow" Foreground="#FFFFFF" FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#25FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#40FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="1" Command="{Binding SignupCommand}" Content="SIGN UP" Margin="5,0,0,0" Height="34" FontWeight="Bold" Cursor="Arrow" Foreground="#000000" FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{Binding Tag, ElementName=MainBorder}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!--           PAYMENT / STATUS OVERLAY         -->
            <!-- ========================================== -->
            <Grid Grid.Row="2" Grid.RowSpan="1" Panel.ZIndex="998" Background="#F0080B14">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPaymentOverlayVisible}" Value="True"/>
                                    <Condition Binding="{Binding IsTxtScanActive}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPaymentOverlayVisible}" Value="True"/>
                                    <Condition Binding="{Binding IsVoiceScanActive}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid>
                    <!-- Main Portal Card -->
                    <Border Width="330" Height="400" CornerRadius="18" Background="#F80F1424" BorderThickness="1.2" BorderBrush="#25FFFFFF" Padding="22,20" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="2" Color="Black" Opacity="0.6"/>
                        </Border.Effect>
                        
                        <Grid>
                            <!-- View State 1: Needs payment -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaymentCreditAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="ACCESS LOCKED" Foreground="#FFFF4444" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Your trial has ended. Pay ₹50 for 3 hours." Foreground="#8E9BAE" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>

                                <!-- QR Code -->
                                <Border Grid.Row="2" Background="#FFFFFF" Padding="8" CornerRadius="12" HorizontalAlignment="Center" Margin="0,10" Width="144" Height="144">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.2"/>
                                    </Border.Effect>
                                    <Image Source="{Binding PaymentQrUrl}" Width="128" Height="128" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>

                                <TextBlock Grid.Row="3" Text="Scan QR to pay ₹50 via UPI" Foreground="#8E9BAE" FontSize="10" HorizontalAlignment="Center"/>

                                <!-- UTR Entry Form -->
                                <StackPanel Grid.Row="4" VerticalAlignment="Center" Margin="0,6">
                                    <TextBlock Text="ENTER 12-DIGIT UPI REF / UTR NO." Foreground="#8E9BAE" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <Border CornerRadius="8" Background="#14FFFFFF" BorderThickness="1" BorderBrush="#22FFFFFF" Padding="10,6">
                                        <TextBox Text="{Binding PaymentUtr, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11.5" CaretBrush="#FFFFFF"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="5">
                                    <TextBlock Text="{Binding PaymentErrorMessage}" Foreground="#FFFF4444" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <Button Command="{Binding SubmitPaymentCommand}" Content="VERIFY PAYMENT" Height="34" FontWeight="Bold" Cursor="Arrow" Foreground="#000000" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{Binding Tag, ElementName=MainBorder}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- View State 2: Credit available, start session -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaymentCreditAvailable}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="PAYMENT VERIFIED" Foreground="#00E676" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,16">
                                    <!-- Dynamic Checkmark SVG icon path -->
                                    <Border Width="52" Height="52" CornerRadius="26" Background="#1500E676" BorderBrush="#3300E676" BorderThickness="1.2" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <Path Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 1,1 20,12A8,8 0 0,1 12,20M16.5,8.5L11,14L7.5,10.5L6,12L11,17L18,9.5L16.5,8.5Z" Fill="#00E676" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="You have 1 active session credit." Foreground="#E0E6ED" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="Click below to start your 3-hour assessment." Foreground="#8E9BAE" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button Grid.Row="2" Command="{Binding StartPaidSessionCommand}" Content="START ASSESSMENT (3 HOURS)" Height="36" FontWeight="Bold" Cursor="Arrow" Foreground="#000000" FontSize="11">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{Binding Tag, ElementName=MainBorder}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Custom Resize Grip (only active when not locked) -->
            <Grid Grid.Row="2" Grid.RowSpan="2" Width="10" Height="10" 
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Arrow" 
                  MouseDown="ResizeGrip_MouseDown" Background="Transparent" Panel.ZIndex="10000">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsClickThrough}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <!-- Tiny corner dash markers -->
                <Path Data="M10,0 L10,10 L0,10 Z M6,10 L10,6 Z M2,10 L10,2 Z" Fill="#55FFFFFF" Margin="2"/>
            </Grid>
        </Grid>
    </Border>
</Window>
